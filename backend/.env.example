# Copy to .env locally. Never commit real credentials.
TOMTOM_API_KEY=
DATABASE_URL=

# Model assets stay outside Git.
TIER1_MODEL_PATH=
TIER1_CONF=0.10
TIER1_IOU=0.50
TIER1_IMGSZ=1280
TIER1_DEVICE=0

# Tier 2: YOLO26s + BoT-SORT. Vehicle subclasses are hidden at app level.
TIER2_MODEL_PATH=yolo26s.pt
TIER2_ENABLED=false
TIER2_TRACKER=botsort.yaml
TIER2_CONF=0.30
TIER2_IMGSZ=640
TIER2_DEVICE=0
TIER2_VID_STRIDE=5
TIER2_SLOW_THRESHOLD_PX=4.95

# Tier 3: trained YOLO11 MVA model + ByteTrack + EasyOCR.
# Classes: Vehicle, Rider, Helmet, No Helmet, Licence Plate.
TIER3_MODEL_PATH=
TIER3_CONF=0.35
TIER3_IMGSZ=800
TIER3_PLATE_CONF=0.35
TIER3_OCR_LANG=en
TIER3_OCR_GPU=true
TIER3_USE_VIDEO_TRACKER=false
TIER3_DEFAULT_VIOLATION=TRAFFIC_RULE_VIOLATION

URBANSENSE_MODELS_ENABLED=false
